# LF everywhere it matters even on a Windows checkout with core.autocrlf:
# shell scripts break with CRLF, and CI diffs proto/gen byte-for-byte against
# a fresh regeneration (nanopb writes LF).
*.sh            text eol=lf
proto/gen/**    text eol=lf
# Test vectors: the recordings are binary (never touch their bytes); the
# JSON is diffed byte-for-byte against a fresh generation, like proto/gen.
proto/testvectors/*.mnr   binary
proto/testvectors/*.json  text eol=lf

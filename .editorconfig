root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ps1,psm1}]
indent_size = 4
end_of_line = unset

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

# Generated by nanopb.
[proto/gen/**]
indent_size = unset
trim_trailing_whitespace = unset

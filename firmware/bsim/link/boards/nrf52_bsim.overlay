/* Split the simulated 512 KB flash: settings (bonds, host slots, keys) and
 * the recordings, as the puck splits its NVS and its QSPI flash. */
/delete-node/ &storage_partition;

&flash0 {
	partitions {
		storage_partition: partition@0 {
			label = "storage";
			reg = <0x00000000 DT_SIZE_K(64)>;
		};
		rec_partition: partition@10000 {
			label = "recordings";
			reg = <0x00010000 DT_SIZE_K(448)>;
		};
	};
};

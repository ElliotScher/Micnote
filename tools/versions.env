# Pinned tool versions for Micnote development. This is the only place they
# are pinned: bootstrap, doctor, CI and the NixHub flake all follow this file.
# Plain KEY=value so bash can `source` it and PowerShell can regex-parse it;
# keep comments on their own lines or after whitespace + '#'.

# nRF Connect SDK release; must match the revision in firmware/west.yml.
# v3.4.x is the first NCS long-term-support line.
NCS_VERSION=v3.4.1
# The Zephyr SDK that NCS_VERSION documents (sdk-zephyr's SDK_VERSION file).
ZEPHYR_SDK_VERSION=1.0.1

# Flutter stable. doctor requires the same major.minor and warns on a
# different patch, because distro/Nix packages trail the patch releases.
FLUTTER_VERSION=3.47.7

# Android NDK r30 (current LTS) and the platform the app compiles against.
ANDROID_NDK_VERSION=30.0.16248370
ANDROID_PLATFORM=36

# Minimums, not exact pins.
# CMake 3.28 is Ubuntu 24.04's version: presets v6+, C++ module scanning.
CMAKE_MIN=3.28
NINJA_MIN=1.11
# C++23: <expected> and <print> need clang 18 + libc++ 18, gcc 14, VS 2022 17.10.
CLANG_MIN=18
GCC_MIN=14
MSVC_MIN=19.40
# Build tooling only (west, nanopb generator); Zephyr 4.4 under NCS 3.4 needs 3.12.
PYTHON_MIN=3.12
# Devicetree compiler minimum from the Zephyr getting-started guide.
DTC_MIN=1.4.6
KICAD_MIN=9.0

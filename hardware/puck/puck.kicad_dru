(version 1)
# JLCPCB rigid 4-layer limits, applied by DRC on top of the board minimums in
# puck.kicad_pro (Board Setup > Constraints). Where JLC allows less, these use
# the plan's numbers (docs/PLAN.md, PCB design): 0.1 mm track and space and
# 0.2/0.45 mm vias, which JLC builds at no extra cost.
# Source: jlcpcb.com/capabilities/pcb-capabilities (checked 2026-11). Re-check
# before each order (stage 6a, §4.5).

(rule "track width"
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.1mm)))

(rule "copper clearance"
	(constraint clearance (min 0.1mm)))

(rule "via drill"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.2mm)))

(rule "via diameter"
	(condition "A.Type == 'Via'")
	(constraint via_diameter (min 0.45mm)))

(rule "via annular ring"
	(condition "A.Type == 'Via'")
	(constraint annular_width (min 0.125mm)))

(rule "PTH annular ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.25mm)))

(rule "plated hole minimum"
	(condition "A.isPlated()")
	(constraint hole_size (min 0.2mm)))

(rule "NPTH minimum"
	(condition "!A.isPlated()")
	(constraint hole_size (min 0.5mm)))

(rule "hole to hole"
	(constraint hole_to_hole (min 0.254mm)))

(rule "hole to hole, different nets"
	(condition "A.Net != B.Net")
	(constraint hole_to_hole (min 0.5mm)))

(rule "pad to track"
	(condition "A.Type == 'Pad' && B.Type == 'Track'")
	(constraint clearance (min 0.2mm)))

(rule "NPTH to copper"
	(condition "!A.isPlated() && A.Type == 'Pad'")
	(constraint hole_clearance (min 0.254mm)))

(rule "copper to board edge"
	(constraint edge_clearance (min 0.3mm)))

(rule "no blind, buried or micro vias"
	(condition "A.Type == 'Via'")
	(constraint disallow blind_via buried_via micro_via))

(rule "silkscreen text"
	(layer "?.Silkscreen")
	(condition "A.Type == 'Text' || A.Type == 'Field'")
	(constraint text_height (min 1.0mm))
	(constraint text_thickness (min 0.153mm)))
